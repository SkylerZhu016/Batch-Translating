{
  "name": "@batch-translating/desktop",
  "version": "0.2.0",
  "private": true,
  "description": "Tauri desktop shell for Batch Translating: a native window that starts the local Batch Translating engine and opens the workbench web UI.",
  "license": "MIT",
  "scripts": {
    "tauri": "tauri",
    "stage:rag": "node ../../scripts/ci/stage-rag-service.mjs",
    "tauri:dev": "pnpm stage:rag && tauri dev",
    "tauri:build": "pnpm stage:rag && tauri build",
    "icons": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-icons.ps1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4"
  }
}
