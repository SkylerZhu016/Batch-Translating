{
  "name": "@batch-translating/translation-rag",
  "version": "0.1.0",
  "private": true,
  "description": "Local BGE-M3 and Qdrant retrieval service for Batch Translating",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "service"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./client/src/index.ts",
      "default": "./client/src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "batch-translation-rag": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsdown src/index.ts src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  }
}
